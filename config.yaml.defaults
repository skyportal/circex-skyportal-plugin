services:
    external:
        circex:
            repo: https://github.com/skyportal/circex-skyportal-plugin.git
            rev: main
            params:
                skyportal:
                    # Writes are attributed to this user. 1 is the super admin a
                    # fresh deployment provisions; point it at a bot user to keep
                    # the provenance clean.
                    user_id: 1
                    group_ids: []
                    # SkyPortal requires an instrument_id on every photometry
                    # point. Rows resolving to neither a mapped instrument nor
                    # this default cannot be posted.
                    default_instrument_id: null
                    # telescope_canonical -> SkyPortal instrument_id
                    instrument_map: {}
                writes:
                    # false plans every write and logs it, committing nothing.
                    live: false
                    alias: true
                    source: true
                    confirm_in_gcn: true
                    comment: true
                resolver:
                    # Rungs tried in order; first hit wins.
                    #   alias       substring match on GcnEvent.aliases
                    #   designation the UTC date encoded in "GRB 260604C"
                    #   trigger     the circular's own trigger time
                    order: [alias, designation, trigger]
                    # Only used for the first circular of an event, before any
                    # alias exists; a designation fixes the day but not the time,
                    # so the search centres on noon and 12 hours spans that day.
                    window_hours: 12
                    localization_cumprob: 0.95
                    retry_interval_seconds: 900
                    retry_max_age_hours: 72
                extractor:
                    # regex | llama | hybrid
                    kind: hybrid
                    # llama.cpp OpenAI-compatible server; empty falls back to a
                    # local server on the default port.
                    llama_url:
                    # llama_require_fields is model-specific and must match:
                    #   Mistral-7B  false, or it pads photometry with invented rows
                    #   Qwen3-27B   true, or it returns {} for every circular
                    llama_model:
                    llama_timeout: 300
                    llama_require_fields: false
                    llama_api_key:
                    sn_type_model: null
                    cache_path: data/circex_llm_cache.sqlite
                consumer:
                    # Needs the `live` extra and GCN credentials.
                    enabled: false
                    topic: gcn.circulars
                    server: gcn.nasa.gov
                    # Unset falls back to SkyPortal's own gcn.client_id /
                    # gcn.client_secret, so there is one copy to rotate.
                    client_id:
                    client_secret:
                    # Must be stable across restarts and distinct from any other
                    # consumer of this topic.
                    group_id: circex
                    offset_reset: latest
                    replay_dir: null
                archive:
                    # Local circular archive for the xref walk; null fetches from
                    # gcn.nasa.gov.
                    dir: null
